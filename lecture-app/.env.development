# フロントからはプロキシプレフィックスのみ（CORS 回避）。実体は VITE_DEV_* で指定。
# Study は /study までをベースに含める（コード側のパスには /study を付けない）
VITE_API_STUDY_ORIGIN=/__proxy_study/study
VITE_API_LOGIN_ORIGIN=/__proxy_login

# 認証 API と Study API は別々に指定可能（未設定時はどちらも 127.0.0.1:8000）
# 例: 認証のみ別ポート
# VITE_DEV_LOGIN_TARGET=http://127.0.0.1:8001
# VITE_DEV_STUDY_TARGET=http://127.0.0.1:8000

VITE_DEV_LOGIN_TARGET=http://127.0.0.1:8000
VITE_DEV_STUDY_TARGET=http://127.0.0.1:8000

# 認証にパスプレフィックスがある場合はベースに含める（プロキシはプレフィックスまで転送）
# 例: VITE_API_LOGIN_ORIGIN=/__proxy_login/api/auth
